# Normalize text for cross-platform development.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must not undergo text conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.sqlite binary
*.db binary
